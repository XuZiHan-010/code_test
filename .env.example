# 复制为 .env 后使用。.env 不提交到仓库。

# 本地默认指向 docker compose 启动的 PostgreSQL
DATABASE_URL=postgres://quiz:quiz@localhost:54329/quiz_dev

# 简答题评分器：deepseek（调用真实接口）或 fake（不联网，按固定规则返回，供开发和测试用）
GRADER=fake

# GRADER=deepseek 时必填
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 全站每天最多评多少道简答题，超出后保持“待评分”，次日自动补评
GRADING_DAILY_CAP=5000

# 设为 1 时，构建要求全部章节都已通过抽查。正式上线的构建必须设置
# CONTENT_REQUIRE_ALL=1
